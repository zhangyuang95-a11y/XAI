# Example names only. Supply values through the shell or Render dashboard.
# This file is not automatically sourced and contains no working credentials.
KITCHEN_NAMESPACE=pilot
KITCHEN_OUTPUT=output/cooperative_kitchen/v3-id-pilot
# Keep a new deployment closed until its hashes, database and QA call pass.
# Formal collection requires a new frozen release and KITCHEN_NAMESPACE=confirmatory.
KITCHEN_ENROLLMENT_MODE=closed
KITCHEN_ALLOW_SQLITE=0
KITCHEN_SECURE_COOKIE=1
KITCHEN_QA_WORKERS=8
# Keep paid cloud explanations disabled in anonymous free play.
KITCHEN_FREEPLAY_QA=0
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
DATABASE_URL=
DEEPSEEK_API_KEY=
KITCHEN_LLM_PROVIDER=deepseek
KITCHEN_LLM_BASE_URL=https://api.deepseek.com
# This is a rolling provider alias, not a pinned model snapshot.
KITCHEN_LLM_MODEL=deepseek-v4-flash
KITCHEN_ADMIN_KEY=
KITCHEN_URL=

# Local backup/recovery only; keep these off the Render service.
# Use Neon's direct (non-pooler) PostgreSQL URL for pg_dump / pg_restore.
KITCHEN_DIRECT_DATABASE_URL=
# A separate, empty database or isolated Neon branch; never the source URL.
KITCHEN_RESTORE_DATABASE_URL=

# For local development instead: KITCHEN_NAMESPACE=development,
# KITCHEN_ALLOW_SQLITE=1, KITCHEN_SECURE_COOKIE=0; leave DATABASE_URL unset.
